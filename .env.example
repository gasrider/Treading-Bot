# Kopiere diese Datei nach ".env" und trage deine Werte ein.
# NIEMALS die .env-Datei hochladen oder weitergeben!

# API-Schlüssel der Börse (nur für mode: live nötig)
# Rechte beim Erstellen: NUR "Abfragen" + "Handeln". KEINE Auszahlungsrechte!
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# Zusätzliche Sicherung: Live-Handel startet nur, wenn hier exakt "JA" steht.
LIVE_TRADING_CONFIRM=NEIN

# Optional: Telegram-Benachrichtigungen
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
