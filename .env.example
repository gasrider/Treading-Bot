# Kopiere diese Datei nach ".env" und trage deine Werte ein.
# NIEMALS die .env-Datei hochladen oder weitergeben!
# (Das Installations-Skript deploy/install.sh füllt sie automatisch aus.)

# ---- Web-Dashboard ----
# Adresse, unter der das Dashboard erreichbar ist (für HTTPS-Zertifikat).
# Ohne eigene Domain: Server-IP mit Bindestrichen + .sslip.io, z. B. 203-0-113-10.sslip.io
DOMAIN=localhost
DASHBOARD_USER=admin
# Mindestens 12 Zeichen!
DASHBOARD_PASSWORD=

# ---- Börse (nur für mode: live nötig) ----
# Rechte beim Erstellen: NUR "Abfragen" + "Handeln". KEINE Auszahlungsrechte!
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# Zusätzliche Sicherung: Live-Handel startet nur, wenn hier exakt "JA" steht.
LIVE_TRADING_CONFIRM=NEIN

# ---- Optional: Telegram-Benachrichtigungen ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- KI kostenlos: Google Gemini (empfohlen) ----
# Schlüssel gratis auf https://aistudio.google.com/apikey (Google-Konto, keine Kreditkarte nötig).
GEMINI_API_KEY=

# ---- Optional, kostenpflichtig: Claude (wird nur genutzt, wenn kein GEMINI_API_KEY gesetzt ist) ----
# Schlüssel erstellen auf https://console.anthropic.com → API Keys. Kosten laufen über dein Anthropic-Konto.
ANTHROPIC_API_KEY=
