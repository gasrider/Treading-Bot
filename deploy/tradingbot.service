# systemd-Dienst (Alternative zu Docker, z. B. auf Raspberry Pi)
# Installation:
#   sudo cp deploy/tradingbot.service /etc/systemd/system/
#   (Pfade und User unten anpassen!)
#   sudo systemctl daemon-reload && sudo systemctl enable --now tradingbot
[Unit]
Description=Krypto Trading Bot
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/Treading-Bot
ExecStart=/home/pi/Treading-Bot/.venv/bin/python main.py run
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
